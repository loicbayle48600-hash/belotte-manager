# --- Obligatoire ---------------------------------------------------------

# Jeton donné par @BotFather (/newbot ou /token). À garder secret : ce fichier
# .env ne doit jamais être publié (il est déjà dans .gitignore).
TELEGRAM_BOT_TOKEN=123456789:AA...

# Identifiant du groupe qui reçoit les messages. Ajoutez le bot au groupe,
# envoyez-y /id, recopiez le nombre affiché (il commence par -100).
TELEGRAM_GROUP_CHAT_ID=-1001234567890

# --- Optionnel -----------------------------------------------------------

# forward : message transféré tel quel, avec le bandeau « Transféré de … ».
# copy    : message recopié sans bandeau, précédé d'un en-tête d'identité.
#FORWARD_MODE=forward

# always : toujours ajouter l'en-tête « qui a écrit, depuis où ».
# auto   : en-tête seulement en mode copy, sur un message modifié ou en repli.
# never  : jamais d'en-tête.
#FORWARD_HEADER=auto

# Sujet (topic) du groupe où déposer les messages, si le groupe utilise les
# sujets. Envoyez /id dans le sujet voulu pour connaître son numéro.
#TELEGRAM_GROUP_THREAD_ID=

# Ne relayer que les conversations privées (true) ou tout (false).
#ONLY_PRIVATE_CHATS=false

# Ignorer les messages envoyés par d'autres bots (recommandé).
#IGNORE_BOTS=true

# Relayer aussi les messages modifiés après envoi.
#FORWARD_EDITS=true

# Déposer les messages sans notification sonore dans le groupe.
#SILENT_FORWARD=false

# --- Hébergement ---------------------------------------------------------

# polling : le bot interroge Telegram, aucune URL publique nécessaire (défaut).
# webhook : Telegram appelle le bot ; exige WEBHOOK_URL en HTTPS public.
#TRANSPORT=polling
#WEBHOOK_URL=https://mon-service.example.com/telegram
#WEBHOOK_SECRET=une-longue-chaine-aleatoire
#PORT=3000
